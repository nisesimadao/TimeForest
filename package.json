{
  "name": "timeforest",
  "version": "0.1.0",
  "private": true,
  "description": "TimeTree 非公式クライアント — デスクトップアプリ / Chrome 拡張 / ユーザースクリプト",
  "scripts": {
    "check": "node scripts/check.js",
    "build": "node build-userscript.js",
    "client": "npm --prefix client start",
    "client:dev": "npm --prefix client run dev",
    "smoke": "cd client && node ../scripts/smoke-client.js",
    "verify:form": "node scripts/verify-form.js",
    "verify:recur": "node scripts/verify-recur.js",
    "verify:notify": "node scripts/verify-notify.js",
    "verify:comment": "node scripts/verify-comment.js",
    "icons": "node scripts/build-icons.js",
    "dist": "node client/node_modules/electron-builder/out/cli/cli.js --config electron-builder.config.js",
    "dist:dir": "node client/node_modules/electron-builder/out/cli/cli.js --config electron-builder.config.js --dir"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
