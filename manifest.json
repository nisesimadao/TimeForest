{
  "manifest_version": 3,
  "name": "TimeForest",
  "version": "0.1.0",
  "description": "TimeTree 自身の UI に アジェンダ表示 / エクスポート(MD・CSV・JSON・ICS) / ダークモード / 地図ピン / アカウント切り替え を足す非公式拡張。",
  "permissions": ["storage", "tabs", "declarativeNetRequest", "cookies"],
  "host_permissions": [
    "https://timetreeapp.com/*",
    "https://tile.openstreetmap.org/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": { "service_worker": "src/bg.js" },
  "commands": {
    "toggle-agenda": {
      "suggested_key": { "default": "Alt+T" },
      "description": "アジェンダを開閉"
    },
    "toggle-dark": {
      "suggested_key": { "default": "Alt+D" },
      "description": "ダークモード切り替え"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://timetreeapp.com/*"],
      "js": [
        "src/lib/tz.js",
        "src/lib/recur.js",
        "src/lib/api.js",
        "src/lib/model.js",
        "src/lib/export.js",
        "src/lib/map.js",
        "src/ui/dark.js",
        "src/ui/mapform.js",
        "src/ui/exportform.js",
        "src/ui/agendaview.js",
        "src/ui/darktoggle.js",
        "src/ui/accounts.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://timetreeapp.com/*"],
      "js": ["src/inject-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "TimeForest — アジェンダを開閉"
  }
}
